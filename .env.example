# Copy to .env and edit. `.env` is gitignored, and CI runs a secret scan over
# the working tree and the full git history on every push.
#
# Almost nothing about a run belongs here. What a suite measures — the cases,
# the graders, the thresholds, the model — lives in the committed suite file,
# because those are the things a reviewer has to see. What is left is the
# handful of settings that differ between a laptop and a CI runner, and none of
# them change what the gate decides.
#
# Variables are AIEVALS_<SECTION>__<FIELD>. Every section forbids unknown keys,
# so a typo is an error rather than a silently ignored line.

# -- how a run executes --------------------------------------------------

# Cases in flight at once. Raise it for a slow remote provider; it makes no
# difference at all when replaying a cassette.
AIEVALS_RUN__CONCURRENCY=4

# Seconds to wait for one completion before recording the case as errored. An
# errored case fails the gate: nothing was measured, and a green build over a
# case that never ran is the worst available outcome.
AIEVALS_RUN__CASE_TIMEOUT_S=120

# Completions drawn per case. Above 1 the gate switches to the paired exact
# test, because a flipped case can then be noise rather than a regression.
# Replaying a cassette five times gives the same answer five times, so this is
# only meaningful against a live provider.
AIEVALS_RUN__SAMPLES=1

# -- diagnostics ---------------------------------------------------------

# DEBUG | INFO | WARNING | ERROR
AIEVALS_LOG__LEVEL=INFO

# json for CI, console for a terminal. Logs always go to stderr — stdout
# carries the report, and a log line in the middle of it is a broken build with
# a confusing cause.
AIEVALS_LOG__FORMAT=console

# -- credentials ---------------------------------------------------------

# Only needed for `aievals record --allow-network`, and only when a suite
# selects the openai_compatible provider. A gate run never reads it: hermetic
# mode refuses to construct a network-facing provider at all.
#
# The suite names this VARIABLE, never the value. There is no code path that
# accepts a credential written in a suite file.
OPENAI_API_KEY=REPLACE_ME

# The endpoint, when it is not OpenAI's. Any OpenAI-compatible gateway or local
# runtime works; only http and https are accepted.
# AIEVALS_BASE_URL=http://127.0.0.1:11434/v1
